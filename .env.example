# Cloudflare R2 (S3-compatible) — used by search.js and tools/
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Public R2 URL read by the api/ functions
R2_PUBLIC_URL=https://<your-bucket>.r2.dev

# Google Sheets export (optional; also needs google-key.json)
GOOGLE_FOLDER_ID=
GOOGLE_SHEET_WEBAPP_URL=

# Discord webhooks for the contact and "add a streamer" forms
DISCORD_CONTACT_WEBHOOK=
DISCORD_REQUEST_WEBHOOK=
